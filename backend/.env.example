# Configurações da porta e host do servidor
PORT=3000
HOST=localhost

# Chave secreta para assinatura de tokens JWT
JWT_SECRET=sua_chave_secreta_jwt

# Configurações do banco de dados MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_mysql
MYSQL_DATABASE=TaskOps

# URL base da API externa de feriados nacionais (opcional, padrão BrasilAPI)
HOLIDAYS_API_URL=https://brasilapi.com.br/api/feriados/v1
